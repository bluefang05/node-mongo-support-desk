{
  "name": "mongo-support-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Support desk API on Express + MongoDB with session auth, role-based access and a React admin.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test",
    "build:web": "npm --prefix web run build",
    "build:demo": "npm --prefix web run build:demo",
    "db:memory": "node scripts/memory-mongo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  }
}
